<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net472</TargetFramework><LangVersion>10</LangVersion>
    <Optimize>true</Optimize><DebugType>none</DebugType><UseSharedCompilation>false</UseSharedCompilation>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildProjectDirectory)/../../Aetherfront-KSP-Smoke/KSP_x64_Data/Managed</GameManaged>
    <BaselineClient>$(MSBuildProjectDirectory)/../../Aetherfront-RC25-Work/Candidate/Client</BaselineClient>
  </PropertyGroup>
  <Target Name="PinGameFramework" BeforeTargets="GetReferenceAssemblyPaths">
    <PropertyGroup><_TargetFrameworkDirectories>$(GameManaged)</_TargetFrameworkDirectories><_FullFrameworkReferenceAssemblyPaths>$(GameManaged)</_FullFrameworkReferenceAssemblyPaths></PropertyGroup>
  </Target>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="ApfCore"><HintPath>$(Rc26CodeRoot)/Patched/ApfCore.dll</HintPath></Reference>
    <Reference Include="KesasInstall"><HintPath>$(Rc26CodeRoot)/Engine/KesasInstall.dll</HintPath></Reference>
    <Reference Include="JsonFx"><HintPath>$(BaselineClient)/GameData/LunaMultiplayer/Plugins/JsonFx.dll</HintPath></Reference>
    <Reference Include="System.IO.Compression"><HintPath>$(BaselineClient)/KSP_x64_Data/Managed/System.IO.Compression.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.IO.Compression.FileSystem"><HintPath>$(BaselineClient)/KSP_x64_Data/Managed/System.IO.Compression.FileSystem.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Numerics"><HintPath>$(BaselineClient)/KSP_x64_Data/Managed/System.Numerics.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
