<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>AetherfrontInstallUI</AssemblyName>
    <RootNamespace>AetherfrontInstallUI</RootNamespace>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <EngineAssembly Condition="'$(EngineAssembly)' == ''">../Engine/bin/Release/net472/KesasInstall.dll</EngineAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="KesasInstall">
      <HintPath>$(EngineAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
