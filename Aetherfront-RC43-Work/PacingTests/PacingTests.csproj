<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable><NoWarn>$(NoWarn);0436</NoWarn><EnableNETAnalyzers>false</EnableNETAnalyzers>
    <ClientPlugins Condition="'$(ClientPlugins)' == ''">$(MSBuildThisFileDirectory)../../../UpdateBuilds/ScienceTransmit-20261104/client</ClientPlugins>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Pacing/*.cs" Link="Pacing/%(Filename)%(Extension)" />
    <Compile Include="Program.cs" /><Compile Include="ClientStubs.cs" />
    <Reference Include="LmpClient"><HintPath>$(ClientPlugins)/LmpClient.dll</HintPath></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(ClientPlugins)/Lidgren.Network.dll</HintPath></Reference>
  </ItemGroup>
</Project>
